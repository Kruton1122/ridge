# Ridge admin traffic dashboard (see ADMIN.md)
# Copy to `.env` on the Pi — never commit real secrets.

# Comma-separated allowlist. Only these emails may bootstrap / sign in.
RIDGE_ADMIN_EMAIL=you@example.com

# Signing secret for admin sessions (long random string).
RIDGE_ADMIN_AUTH_SECRET=replace-with-long-random-secret

# Public origin as browsers see it (Cloudflare hostname).
RIDGE_ADMIN_BASE_URL=https://ridgebench.com

# WebAuthn rpID — usually the bare hostname of RIDGE_ADMIN_BASE_URL.
RIDGE_ADMIN_RP_ID=ridgebench.com

# Optional later: Cloudflare GraphQL Analytics API (stubbed until wired).
# CLOUDFLARE_ANALYTICS_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ZONE_ID=
